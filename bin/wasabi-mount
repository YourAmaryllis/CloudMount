#!/usr/bin/env bash
# Mount a configured remote by id: wasabi-mount <id>
# Supports mount_kind: fuse (rclone mount) | nfs (rclone nfsmount)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "$ROOT/lib/common.sh"
# shellcheck source=../lib/capabilities.sh
source "$ROOT/lib/capabilities.sh"

id="${1:-}"
notify_fail() {
  local msg="$1"
  log_action "mount FAIL $id: $msg"
  ui_notify "$msg" "Wasabi mount failed"
  ui_alert "$msg

See logs:
$WASABI_LOG_DIR" "Wasabi mount failed" || true
}

if [[ -z "$id" ]]; then
  notify_fail "Usage: wasabi-mount <id>"
  exit 1
fi

row="$(get_mount_by_id "$id" || true)"
if [[ -z "$row" ]]; then
  notify_fail "Unknown mount id: $id"
  exit 1
fi

IFS=$'\t' read -r mid label remote path mode kind <<<"$row"
path="$(expand_path "$path")"
kind="${kind:-fuse}"

if is_mounted "$path"; then
  log_action "mount already up: $mid ($kind)"
  ui_notify "Already mounted: $label"
  exit 0
fi

if ! "$ROOT/bin/ensure-rclone" >>"$WASABI_LOG_DIR/ensure-rclone.log" 2>&1; then
  notify_fail "Could not download/find rclone binary. See logs/ensure-rclone.log"
  exit 1
fi

if ! load_wasabi_env; then
  notify_fail "Could not load credentials from $WASABI_CREDS_FILE"
  exit 1
fi

# Capability gates
case "$kind" in
  nfs)
    if ! nfs_ready; then
      notify_fail "NFS mount not available.

This rclone build has no nfsmount, or detection failed.
Run: wasabi-capabilities
Then: ensure-rclone --force (official binary)."
      exit 1
    fi
    rclone_cmd="nfsmount"
    ;;
  fuse|*)
    kind="fuse"
    if ! fuse_ready; then
      if ! macfuse_installed; then
        notify_fail "FUSE mount needs macFUSE.

Install:
  brew install --cask macfuse
or open https://macfuse.github.io/

Then allow the system extension and re-run Mount.
Or switch this mount to NFS (mount_kind: nfs)."
        # Open help without blocking forever
        help_install_macfuse >/dev/null 2>&1 || true
        exit 1
      fi
      notify_fail "rclone FUSE mount not available on this binary.
Run: wasabi-capabilities
Use official rclone (ensure-rclone), not brew-only."
      exit 1
    fi
    rclone_cmd="mount"
    ;;
esac

ensure_log_dir
mkdir -p "$path"

bin="$(rclone_bin)"
if [[ ! -x "$bin" ]]; then
  notify_fail "rclone not executable: $bin"
  exit 1
fi

logfile="$WASABI_LOG_DIR/${mid}.log"
log_action "mount start: $mid kind=$kind $remote → $path via $bin $rclone_cmd"

# Detach so SwiftBar cannot kill rclone when the menu action exits.
detach_exec "$logfile" \
  "$bin" "$rclone_cmd" "$remote" "$path" \
  --vfs-cache-mode "${mode:-full}" \
  --dir-cache-time 5m \
  --poll-interval 1m

for _ in $(seq 1 30); do
  if is_mounted "$path"; then
    log_action "mount OK: $mid ($kind)"
    ui_notify "Mounted $label ($kind)"
    exit 0
  fi
  sleep 0.5
done

tail_msg="$(tail -n 15 "$logfile" 2>/dev/null || echo "(no log)")"
if is_mounted "$path"; then
  ui_notify "Mounted $label ($kind)"
  exit 0
fi

notify_fail "Mount of “$label” ($kind) did not come up.

$remote → $path

$tail_msg"
exit 1
