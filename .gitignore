# Downloaded rclone binaries (fetched by ensure-rclone)
vendor/rclone/**
!vendor/rclone/.gitkeep

# Runtime logs
logs/*
!logs/.gitkeep

# Build artifacts
dist/
__pycache__/
*.pyc
.DS_Store

# Swift package build output (mac-app/)
.build/
.swiftpm/

# Local overrides
config/mounts.local.yaml
.env
.env.*

